generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// --- Auth.js models (credentials only) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts Account[]
  sessions Session[]

  nutritionPlans     NutritionPlan[]
  foodLogs           FoodLog[]
  customFoods        CustomFood[]
  recipes            Recipe[]
  menuEntries        MenuEntry[]
  shoppingListChecks ShoppingListCheck[]
  workoutPlans       WorkoutPlan[]
  workoutLogs        WorkoutLog[]
  exerciseTemplates  ExerciseTemplate[]
  personalRecords    PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model NutritionPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  targetCalories Int?
  targetProtein  Float?
  targetCarbs    Float?
  targetFat      Float?

  meals MealTemplate[]

  // Original HabitForge NutritionPlan.id — one-time import bookkeeping only.
  sourceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MealTemplate {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  mealType MealType
  name     String
  calories Int?
  protein  Float?
  carbs    Float?
  fat      Float?

  @@index([planId])
}

model FoodLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  mealType    MealType
  name        String
  calories    Int?
  protein     Float?
  carbs       Float?
  fat         Float?
  gramsLogged Float?
  notes       String?

  sourceId String? @unique

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model CustomFood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  // Computed at create time from `components`, so this can be handed to
  // FoodSearchCombobox/FoodLogForm as a plain per-100g source with no
  // joins or client-side math - the same mechanism as an OFF search hit.
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?

  components CustomFoodComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CustomFoodComponent {
  id           String     @id @default(cuid())
  customFoodId String
  customFood   CustomFood @relation(fields: [customFoodId], references: [id], onDelete: Cascade)

  name            String
  grams           Float
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?

  @@index([customFoodId])
}

model Recipe {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  mealType     MealType
  servings     Int      @default(1)
  instructions String
  prepMinutes  Int?
  cookMinutes  Int?

  // Snapshotted per serving from `ingredients` at create/update time, the
  // same pattern CustomFood already uses for its per-100g snapshot - so
  // menu generation and the shopping list can read macros for every
  // candidate recipe in a month-long scan without summing ingredients
  // each time. Unlike FoodLog, MenuEntry does NOT keep its own snapshot -
  // a menu is a forward-looking plan, not a historical log, so correcting
  // a recipe should retroactively improve the current month's projection.
  caloriesPerServing Int?
  proteinPerServing  Float?
  carbsPerServing    Float?
  fatPerServing      Float?

  ingredients RecipeIngredient[]
  menuEntries MenuEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, mealType])
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Editable, not just the picked search result's name verbatim - this is
  // the practical lever for shopping-list name normalization (exact-match
  // aggregation, no fuzzy matching - see shopping-list-calc.ts).
  name            String
  grams           Float
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?

  @@index([recipeId])
}

model MenuEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime // local midnight, same convention as FoodLog.date
  mealType MealType
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servings Float    @default(1)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ShoppingListCheck {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthKey String // "2026-09"
  itemKey  String // normalized ingredient name (trim+lowercase, same key computeShoppingList uses)
  checked  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, monthKey, itemKey])
  @@index([userId, monthKey])
}

model WorkoutPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  daysPerWeek Int?
  isArchived  Boolean @default(false)

  exercises PlanExercise[]
  logs      WorkoutLog[]

  sourceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PlanExercise {
  id     String      @id @default(cuid())
  planId String
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  name        String
  muscleGroup String?
  sets        Int?
  repsPerSet  Int?
  weightKg    Float?
  orderInPlan Int     @default(0)
  notes       String?

  @@index([planId])
}

model WorkoutLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String?
  plan   WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  date            DateTime
  durationMinutes Int?
  notes           String?

  exerciseLogs    ExerciseLog[]
  personalRecords PersonalRecord[]

  sourceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model ExerciseLog {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  name        String
  muscleGroup String?
  sets        Int?
  repsPerSet  Int?
  weightKg    Float?
  notes       String?

  @@index([workoutLogId])
}

model ExerciseTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  muscleGroup String
  equipment   String
  isSystem    Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  records PersonalRecord[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([muscleGroup])
}

model PersonalRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseTemplateId String?
  exerciseTemplate   ExerciseTemplate? @relation(fields: [exerciseTemplateId], references: [id], onDelete: SetNull)

  exerciseName String
  recordType   String // "max_weight" | "max_reps" | "max_volume"
  value        Float
  unit         String
  achievedAt   DateTime

  workoutLogId String?
  workoutLog   WorkoutLog? @relation(fields: [workoutLogId], references: [id], onDelete: SetNull)

  notes String?

  sourceId String? @unique

  @@index([userId])
  @@index([exerciseTemplateId])
}
